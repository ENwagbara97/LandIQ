{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend/Land-Intelligence/artifacts/landiq && npm install --legacy-peer-deps --ignore-scripts",
  "buildCommand": "cd frontend/Land-Intelligence/artifacts/landiq && npm run build",
  "outputDirectory": "frontend/Land-Intelligence/artifacts/landiq/dist/public",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}